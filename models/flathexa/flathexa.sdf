    <link name='lidar_link'>
        <pose>0 0 0.10 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.05</mass>
          <inertia>
            <ixx>9.75e-07</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.000273104</iyy>
            <iyz>0</iyz>
            <izz>0.000274004</izz>
          </inertia>
        </inertial>
        <visual name='lidar_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://flathexa/meshes/rplidar.dae</uri>
            </mesh>
            <!-- <cylinder>
              <radius>0.038</radius>
              <length>0.041</length>
            </cylinder> -->
          </geometry>
          <material>
            <script>
              <name>Gazebo/DarkGrey</name>
