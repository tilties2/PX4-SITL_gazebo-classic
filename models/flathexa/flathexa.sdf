    <link name="camera_vio_fisheye1_frame">
      <pose>-0.145 -0.0411 -0.04 0 0.78539816339 3.1415926536</pose>
      <inertial>
        <pose>0.0 0 0 0 0 0</pose>
        <mass>1e-05</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-05</iyy>
          <iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
      <sensor name="camera_vio_fisheye1" type="wideanglecamera">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.95</horizontal_fov>
          <image>
            <width>848</width>
            <height>800</height>
          </image>
          <clip>
            <near>0.2</near>
            <far>100</far>
          </clip>
         <lens>
            <!-- type element is mandatory -->
            <type>orthographic</type>
            <!-- if it is set to `true` your horizontal FOV will remain as defined -->
            <!-- othervise it depends on lens type and custom function, if there is one -->
            <scale_to_hfov>true</scale_to_hfov>
            <!-- clip everything that is outside of this angle -->
            <!-- eye balled value for these cameras-->
            <cutoff_angle>2.20</cutoff_angle>
            <!-- resolution of the cubemap texture, the highter it is - the sharper is your image -->
            <env_texture_size>1024</env_texture_size>
          </lens>
          <!--<distortion>-->
            <!--<k1>-0.00040996368625201285</k1>-->
            <!--<k2>0.03653175011277199</k2>-->
            <!--<k3>0.0</k3>-->
            <!--<p1>-0.034823670983314514</p1>-->
            <!--<p2>0.0052825710736215115</p2>-->
            <!--<center>0.5 0.5</center>-->
          <!--</distortion>-->
        </camera>
         <plugin name="camera_vio_fisheye1" filename="libgazebo_ros_camera.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>30.0</updateRate>
          <cameraName>camera_vio/fisheye1</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>camera_vio_fisheye1_frame</frameName>
          <hackBaseline>0.07</hackBaseline>
          <distortionK1>-0.00040996368625201285</distortionK1>
          <distortionK2>0.03653175011277199</distortionK2>
          <distortionK3>0.0</distortionK3>
          <distortionP1>-0.034823670983314514</distortionP1>
          <distortionP2>0.0052825710736215115</distortionP2>
          <Cx>416.22</Cx>
          <Cy>402.1</Cy>
          <CxPrime>416.22</CxPrime>
        </plugin>
      </sensor>
    </link>

    <joint name="camera_vio_fisheye1_joint" type="revolute">
      <parent>camera_vio_link</parent>
      <child>camera_vio_fisheye1_frame</child>
      <axis>
        <xyz>1 0 0</xyz>
