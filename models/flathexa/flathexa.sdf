    <link name='range_sensor_link'>
        <pose>0 0 -0.065 0 1.57 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.00005</mass>
          <inertia>
            <ixx>9.75e-07</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.000273104</iyy>
            <iyz>0</iyz>
            <izz>0.000274004</izz>
          </inertia>
        </inertial>
        <gravity>1</gravity>
        <velocity_decay/>
        <self_collide>0</self_collide>
        <sensor type="ray" name="sensor_range">
          <visualize>false</visualize>
          <update_rate>100</update_rate>
          <ray>
              <scan>
                  <horizontal>
                      <samples>1</samples>
                      <resolution>1</resolution>
                      <min_angle>0.0</min_angle>
                      <max_angle>0.0</max_angle>
                  </horizontal>
                  <vertical>
                      <samples>10</samples>
                      <resolution>1</resolution>
                      <min_angle>-0.174533</min_angle>
                      <max_angle>0.174533</max_angle>
                  </vertical>
              </scan>
              <range>
                  <min>0.5</min>
                  <max>40.0</max>
                  <resolution>0.05</resolution>
              </range>
          </ray>
          <plugin name='gazebo_ros_range' filename='libgazebo_ros_range.so'>
            <updateRate>100</updateRate>
            <topicName>range</topicName>
            <parentFrameName>range_link</parentFrameName>
            <frameName>range_sensor_link</frameName>
          </plugin>
        </sensor>
    </link>

